{
  "name": "str8n",
  "version": "1.0.0",
  "main": "index",
  "scripts": {
    "start": "npx expo start",
    "android": "npx expo prebuild --clean && npx expo run:android",
    "ios": "npx expo prebuild --clean && npx expo run:ios",
    "web": "npx expo start --web",
    "build:web": "npx expo export --platform web",
    "build:android": "npx expo prebuild --clean --platform android",
    "build:ios": "npx expo prebuild --clean --platform ios",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "type-check:strict": "tsc --noEmit --strict",
    "check": "npm run type-check:strict && npm run lint",
    "upgrade:expo": "npx expo install expo@latest && npx expo install --fix",
    "update:expo": "npm run upgrade:expo"
  },
  "dependencies": {
    "@expo-google-fonts/orbitron": "^0.2.3",
    "@expo/vector-icons": "^15.0.3",
    "@lodev09/react-native-exify": "^0.2.7",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.6.2",
    "@techstark/opencv-js": "^4.10.0-release.1",
    "expo": "57",
    "expo-asset": "~57.0.15",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.16",
    "expo-dev-client": "~57.0.16",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.2",
    "expo-image": "~57.0.3",
    "expo-image-picker": "~57.0.14",
    "expo-linking": "~57.0.8",
    "expo-router": "~57.0.17",
    "expo-sharing": "~57.0.16",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "file-saver": "^2.0.5",
    "module-alias": "^2.2.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-fast-opencv": "^0.4.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "typescript": "~5.9.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@eslint/js": "^9.23.0",
    "@types/file-saver": "^2.0.7",
    "@types/react": "~19.2.10",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.0.2",
    "eslint-import-resolver-typescript": "^4.3.1",
    "eslint-plugin-prettier": "^5.2.3",
    "prettier": "^3.5.3",
    "react-native-svg-transformer": "^1.5.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.28.0"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "enabled": true,
        "exclude": [
          "@techstark/opencv-js",
          "file-saver",
          "module-alias",
          "@lodev09/react-native-exify",
          "typescript"
        ],
        "listUnknownPackages": true
      }
    }
  },
  "private": true
}
